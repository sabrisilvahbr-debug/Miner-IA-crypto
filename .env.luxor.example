# =====================================================================
# AI CRYPTO MINER — VIRTUAL MINING OFFICE 50
# Configuração de produção: pool Luxor + Bitcoin (ASIC SHA-256)
#
# Uso: copie este arquivo para ".env" na pasta do projeto e preencha
# apenas os campos marcados com  <-- PREENCHA.
# O ".env" é ignorado pelo Git. Nunca compartilhe este arquivo preenchido.
# Campos vazios são tratados como "não configurado": o agente
# correspondente fica desconectado ou simulado e explica o motivo.
# =====================================================================

# ---------- Servidor ----------
# 0.0.0.0 permite abrir o painel pelo iPhone na mesma rede Wi-Fi. Exige API_TOKEN.
HOST=0.0.0.0
PORT=8050
# Gere com:  npm run token   (cole o resultado aqui e no iPhone, no primeiro acesso)
API_TOKEN=                                  # <-- PREENCHA

# ---------- Pool principal: Luxor (somente leitura) ----------
POOL_SOURCE=luxor
LUXOR_API_URL=https://app.luxor.tech/api/v2
LUXOR_API_KEY=                              # <-- PREENCHA: Workspace → API Keys no painel da Luxor
LUXOR_CURRENCY=BTC
LUXOR_SUBACCOUNT=                           # <-- PREENCHA: subconta criada no painel da Luxor (sem símbolos)
LUXOR_WORKER_NAME=                          # opcional até ter um ASIC: nome do equipamento (sem símbolos)
LUXOR_SITE_ID=
# Endereço oficial do guia "Getting Started" da Luxor. É a única pool que o Guardião aceita.
ALLOWED_POOLS=stratum+tcp://btc.global.luxor.tech:700

# ---------- Minerador (ASIC com API cgminer/bmminer, somente leitura) ----------
# Sem minerador compatível com a Luxor por enquanto (uma RTX 3060 não minera BTC/LTC/ZEC/SC de forma viável).
# Quando tiver um ASIC: MINER_TYPE=cgminer e MINER_URL=tcp://IP-DO-ASIC:4028
MINER_TYPE=none
MINER_URL=
MINER_ACCESS_TOKEN=
MINER_ALGO=sha256d
MIN_MINER_VERSION=

# ---------- Mercado e rede Bitcoin (APIs públicas, sem chave) ----------
MARKET_SOURCE=coinbase
PRICE_PAIRS=BTC-USD,BTC-BRL
NETWORK_SOURCE=mempool
LOCAL_CURRENCY=BRL

# ---------- Carteira de recebimento (consulta pública, sem chave) ----------
# Monitoramento de recebimentos desligado por escolha do operador. Para ligar: WALLET_SOURCE=mempool + endereço.
WALLET_SOURCE=none
WALLET_BTC_ADDRESS=
ALLOWED_WALLETS=

# ---------- Energia (para estimar custo e resultado) ----------
# Ainda não informados: custo de energia e resultado líquido ficam indisponíveis.
POWER_WATTS=                                # opcional: consumo do equipamento em watts
ENERGY_PRICE_KWH=                           # opcional: tarifa em R$/kWh (consta na conta de luz)

# ---------- Limites do Guardião de Risco ----------
MAX_TEMP_C=80
CRITICAL_TEMP_C=90
MAX_REJECT_RATE_PCT=5
MAX_RESTARTS_PER_HOUR=3
MAX_ACTIONS_PER_HOUR=10

# ---------- Execução ----------
MAX_CONCURRENCY=4
TASK_TIMEOUT_MS=15000
MAX_RETRIES=2
RETRY_BASE_MS=500
EXTERNAL_CALLS_PER_MINUTE=30
RETENTION_DAYS=30
DATA_DIR=data
AUTOSTART=true

# ---------- LLM (opcional; o plano Claude Pro NÃO inclui chave de API) ----------
LLM_ENABLED=false
ANTHROPIC_API_KEY=                          # <-- PREENCHA só se for usar (e mude LLM_ENABLED para true)
LLM_MODEL=claude-haiku-5-5
LLM_MAX_CALLS_PER_DAY=10
LLM_MAX_TOKENS_PER_MONTH=200000

# ---------- Notificações no Telegram (opcional) ----------
TELEGRAM_BOT_TOKEN=                         # <-- PREENCHA só se for usar
TELEGRAM_CHAT_ID=                           # <-- PREENCHA só se for usar
