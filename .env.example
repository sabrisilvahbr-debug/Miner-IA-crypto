# Copie para .env e ajuste. Nunca envie o .env para o GitHub.

# ---------- Servidor ----------
HOST=127.0.0.1            # use 0.0.0.0 para abrir no iPhone pela rede local (exige API_TOKEN)
PORT=8050
# API_TOKEN=troque-por-um-token-longo-e-aleatorio

# ---------- Fontes de dados ----------
# "simulated" gera dados de demonstração etiquetados como SIMULADO.
MARKET_SOURCE=simulated   # coinbase = cotação pública da Coinbase (somente leitura)
PRICE_PAIRS=BTC-USD,BTC-BRL
NETWORK_SOURCE=simulated  # mempool = dificuldade, altura e taxas via mempool.space
LOCAL_CURRENCY=BRL

# ---------- Minerador ----------
MINER_TYPE=simulated      # cgminer (ASIC, porta 4028) | xmrig (HTTP API) | none
# MINER_URL=tcp://192.168.0.50:4028      # cgminer/bmminer
# MINER_URL=http://127.0.0.1:8080        # xmrig (habilite "http" no config.json do XMRig)
# MINER_ACCESS_TOKEN=                    # access-token do XMRig
MINER_ALGO=sha256d
# MIN_MINER_VERSION=6.21.0

# ---------- Pool ----------
POOL_SOURCE=simulated     # luxor = pool principal via API oficial (somente leitura) | json | none

# Luxor (https://docs.luxor.tech/platform/api/introduction). A chave fica SOMENTE aqui no backend.
# LUXOR_API_KEY=cole-a-chave-do-workspace-aqui
LUXOR_CURRENCY=BTC        # BTC | LTC_DOGE | SC | ZEC
# LUXOR_SUBACCOUNT=       # subconta criada no painel da Luxor (sem símbolos)
# LUXOR_WORKER_NAME=      # nome do equipamento (sem símbolos)
# LUXOR_SITE_ID=          # opcional
# Pool do minerador, conforme o guia da Luxor: stratum+tcp://btc.global.luxor.tech:700
# ALLOWED_POOLS=stratum+tcp://btc.global.luxor.tech:700

# POOL_STATS_URL=https://sua-pool/api/estatisticas?usuario=SEU_USUARIO
# POOL_BALANCE_PATH=data.unpaid
# POOL_PAID_PATH=data.paid
# POOL_HASHRATE_PATH=data.hashrate
# POOL_STRATUM_URL=stratum+tcp://pool.exemplo.com:3333
# ALLOWED_POOLS=stratum+tcp://pool-a:3333,stratum+tcp://pool-b:3333

# ---------- Carteira de recebimento (somente leitura) ----------
WALLET_SOURCE=simulated   # mempool = consulta pública do endereço | none
# WALLET_BTC_ADDRESS=bc1q...   # ex.: endereço de depósito BTC da sua conta Coinbase
# ALLOWED_WALLETS=bc1q...

# ---------- Energia ----------
# POWER_WATTS=3250
# ENERGY_PRICE_KWH=0.85

# ---------- Limites do Guardião de Risco ----------
MAX_TEMP_C=80
CRITICAL_TEMP_C=90
MAX_REJECT_RATE_PCT=5
MAX_RESTARTS_PER_HOUR=3
MAX_ACTIONS_PER_HOUR=10

# ---------- Execução ----------
MAX_CONCURRENCY=4
TASK_TIMEOUT_MS=15000
MAX_RETRIES=2
EXTERNAL_CALLS_PER_MINUTE=30
RETENTION_DAYS=30

# ---------- LLM (opcional; o plano Claude Pro NÃO inclui chave de API) ----------
LLM_ENABLED=false
# ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_MAX_CALLS_PER_DAY=10
LLM_MAX_TOKENS_PER_MONTH=200000

# ---------- Notificações (opcional) ----------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
