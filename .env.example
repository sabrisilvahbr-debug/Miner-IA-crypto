# Copie para .env e ajuste. Nunca envie o .env para o GitHub.
# Este sistema NÃO usa dados simulados em produção: fonte não configurada aparece como INDISPONÍVEL.
# Modelo completo para Luxor + RTX 3050: veja .env.luxor.example.

# ---------- Ambiente ----------
# production (padrão): simulação proibida. "test" é reservado à suíte de testes automatizados.
APP_ENV=production

# ---------- Servidor ----------
HOST=127.0.0.1            # use 0.0.0.0 só para abrir no iPhone pela rede local (exige API_TOKEN)
PORT=8050
# API_TOKEN=gere-com-npm-run-token

# ---------- Fontes de dados (somente leitura) ----------
MARKET_SOURCE=coinbase    # cotação pública da Coinbase | none
PRICE_PAIRS=BTC-USD,BTC-BRL
NETWORK_SOURCE=mempool    # dificuldade, altura e taxas via mempool.space | none
LOCAL_CURRENCY=BRL

# ---------- GPU (nvidia-smi, somente leitura) ----------
# Só preencha se o nvidia-smi não estiver no PATH do Windows:
# NVIDIA_SMI_PATH=C:\Windows\System32\nvidia-smi.exe

# ---------- Minerador ----------
# Nenhum minerador de GPU verificado ainda: a mineração fica DESATIVADA.
MINER_TYPE=none           # cgminer (ASIC, porta 4028) | xmrig (HTTP API) | none
# MINER_URL=tcp://192.168.0.50:4028
MINER_ALGO=sha256d

# ---------- Pool ----------
POOL_SOURCE=none          # luxor = API oficial (somente leitura) | json | none
# LUXOR_API_KEY=
LUXOR_CURRENCY=BTC        # BTC | LTC_DOGE | SC | ZEC

# ---------- Carteira de recebimento (somente leitura) ----------
WALLET_SOURCE=none        # mempool = consulta pública do endereço BTC | none
# WALLET_BTC_ADDRESS=bc1q...

# ---------- Energia ----------
# ENERGY_COST_MODE: informado (modalidade A) | medido (modalidade B) | comparar (mostra os dois, nunca soma)
ENERGY_COST_MODE=comparar
# ENERGY_PRICE_KWH=0.90          # tarifa da conta de luz (R$/kWh)
# ENERGY_MONTHLY_COST=110        # custo mensal que VOCÊ estimou (modalidade A)
# POWER_WATTS=                   # consumo médio que você mediu durante a mineração (W)
OPERATION_HOURS_PER_DAY=24
ENERGY_DAYS_PER_MONTH=30

# ---------- Rentabilidade de GPU ----------
MINING_DATA_SOURCE=whattomine    # coins.json público | none
MINING_DATA_MAX_AGE_MIN=15
# GPU_HASHRATE_PRL=              # hashrate MEDIDO pelo minerador, na unidade do nethash da WhatToMine

# ---------- Limites do Guardião de Risco ----------
MAX_TEMP_C=80
CRITICAL_TEMP_C=90
MAX_REJECT_RATE_PCT=5
MAX_RESTARTS_PER_HOUR=3
MAX_ACTIONS_PER_HOUR=10

# ---------- Execução ----------
MAX_CONCURRENCY=4
TASK_TIMEOUT_MS=15000
MAX_RETRIES=2
EXTERNAL_CALLS_PER_MINUTE=30
RETENTION_DAYS=30

# ---------- LLM (opcional; o plano Claude Pro NÃO inclui chave de API) ----------
LLM_ENABLED=false
# ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_MAX_CALLS_PER_DAY=10
LLM_MAX_TOKENS_PER_MONTH=200000

# ---------- Notificações (opcional) ----------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
